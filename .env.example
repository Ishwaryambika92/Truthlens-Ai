# ==============================================================================
# TruthLens AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your secrets locally for development.
# Never commit real API keys, credentials, or .env files to version control.
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-strong-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///db.sqlite3

# Google Gemini API (Generative AI for claim extraction, summaries, explanations)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (Alternative/Secondary LLM provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Fact Check Tools API (Accredited journalist fact-check search)
FACT_CHECK_API_KEY=your_fact_check_api_key_here

# Tavily Search API (Real-time factual web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Sarvam AI API (Indic language translation & regional news support)
SARVAM_API_KEY=your_sarvam_api_key_here
